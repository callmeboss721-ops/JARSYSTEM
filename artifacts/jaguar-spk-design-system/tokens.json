    "brandId2026": {
      "$type": "color",
      "$description": "JAGUAR SPK Brand ID 2026 · Clean Executive Dark. Scoped to Jaguar House; v3 light/dark roles remain unchanged.",
      "background": {
        "$value": "#090D0B",
        "$description": "Deep matte obsidian canvas."
      },
      "surface": { "$value": "#101713" },
      "surfaceRaised": {
        "$value": "#16201B",
