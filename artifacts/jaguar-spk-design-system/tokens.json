{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f5f3ea" },
      "foreground": { "$value": "#1c211a" },
      "border": { "$value": "#d9d7c7" },
      "card": { "$value": "#fffefa" },
      "cardForeground": { "$value": "#20251e" },
      "popover": { "$value": "#fffefa" },
      "popoverForeground": { "$value": "#20251e" },
      "primary": {
        "$value": "#9b7620",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#17170f" },
      "secondary": { "$value": "#e8f0e7" },
      "secondaryForeground": { "$value": "#173222" },
      "muted": { "$value": "#ecece5" },
      "mutedForeground": { "$value": "#586057" },
      "accent": { "$value": "#ddf5e8" },
      "accentForeground": { "$value": "#0f432d" },
      "destructive": { "$value": "#a7372c" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#c6c7bc" },
      "ring": { "$value": "#25845b" },
      "chart1": { "$value": "#9b7620" },
      "chart2": { "$value": "#1f8a64" },
      "chart3": { "$value": "#2fd98a" },
      "chart4": { "$value": "#656f63" },
      "chart5": { "$value": "#c76a3f" },
      "sidebar": { "$value": "#ecece5" },
      "sidebarForeground": { "$value": "#30372f" },
      "sidebarBorder": { "$value": "#d9d7c7" },
      "sidebarPrimary": { "$value": "#9b7620" },
      "sidebarPrimaryForeground": { "$value": "#17170f" },
      "sidebarAccent": { "$value": "#ddf5e8" },
      "sidebarAccentForeground": { "$value": "#0f432d" },
      "sidebarRing": { "$value": "#25845b" }
    },
    "dark": {
      "background": { "$value": "#040605" },
      "foreground": { "$value": "#eeeae0" },
      "border": { "$value": "#272c28" },
      "card": { "$value": "#0b0c12" },
      "cardForeground": { "$value": "#eeeae0" },
      "popover": { "$value": "#12141b" },
      "popoverForeground": { "$value": "#eeeae0" },
      "primary": { "$value": "#e5c04a" },
      "primaryForeground": { "$value": "#17170f" },
      "secondary": { "$value": "#1f8a64" },
      "secondaryForeground": { "$value": "#f4f5ee" },
      "muted": { "$value": "#181b19" },
      "mutedForeground": { "$value": "#a3a6b0" },
      "accent": { "$value": "#173a2d" },
      "accentForeground": { "$value": "#d7f3e4" },
      "destructive": { "$value": "#78372e" },
      "destructiveForeground": { "$value": "#fff4e9" },
      "input": { "$value": "#363c3a" },
      "ring": { "$value": "#2fd98a" },
      "chart1": { "$value": "#e5c04a" },
      "chart2": { "$value": "#1f8a64" },
      "chart3": { "$value": "#2fd98a" },
      "chart4": { "$value": "#c4cad6" },
      "chart5": { "$value": "#ff7a6b" },
      "sidebar": { "$value": "#0b0c12" },
      "sidebarForeground": { "$value": "#eeeae0" },
      "sidebarBorder": { "$value": "#272c28" },
      "sidebarPrimary": { "$value": "#e5c04a" },
      "sidebarPrimaryForeground": { "$value": "#17170f" },
      "sidebarAccent": { "$value": "#173a2d" },
      "sidebarAccentForeground": { "$value": "#d7f3e4" },
      "sidebarRing": { "$value": "#2fd98a" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["IBM Plex Sans Thai", "Bai Jamjuree", "sans-serif"],
        "$description": "Thai-first UI/body stack; Bai Jamjuree is the source display face."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["JetBrains Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "1rem",
      "$description": "Source glass panels use a rounded 16–18px radius."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
